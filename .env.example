# Optional compatibility file. New setups only need config.toml:
# copy config.example.toml to config.toml and configure the app there.
# Credentials can live in config.toml too, so no split configuration is required.
# This .env file only fills settings absent from TOML. Actual process environment
# variables override TOML, which is useful for deployments.

# CONFIG_FILE="config.toml"
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
